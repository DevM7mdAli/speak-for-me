{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@speak-for-me/brand": ["libs/brand/src/index.ts"],
      "@speak-for-me/content": ["libs/content/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
