{
  "name": "speak-for-me",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "mobile": "pnpm --filter @speak-for-me/mobile",
    "web": "pnpm --filter @speak-for-me/web",
    "dev": "nx run @speak-for-me/web:dev",
    "build": "nx run-many -t build",
    "build:web": "nx run @speak-for-me/web:build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph"
  },
  "devDependencies": {
    "nx": "23.1.2"
  }
}
