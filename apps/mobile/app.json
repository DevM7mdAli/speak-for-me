{
  "expo": {
    "name": "Speak For Me",
    "slug": "speak-for-me",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v2.png",
    "scheme": "speakforme",
    "userInterfaceStyle": "light",
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "f782dc0c-61b1-41cc-b648-c31e21381718"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devm7mdali.speakforme",
      "buildNumber": "2",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.devm7mdali.speakforme",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#006C67",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F6F5",
          "image": "./assets/images/brand-mark-v2.png",
          "imageWidth": 132
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allows a caregiver to attach a photo to a custom phrase card.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "./plugins/withAndroidReleaseSigning.js",
      "./plugins/withPodResourceBundleDeploymentTarget.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "devm7mdali"
  }
}
